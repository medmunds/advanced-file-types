<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.medmunds.advancedfiletypes</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Advanced File Types</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://github.com/medmunds/advanced-file-types">Mike Edmunds</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <!-- The first two lines are designed to (almost) fit in the plugin card. The extra space on line 2 is needed. -->
    <description><![CDATA[
        Adds project-level file types using glob or regex with full path matching.
         Also loads types from VS Code settings and Git linguist attributes.

        <h2>Features</h2>
        <ul>
            <li><strong>Project-specific file types:</strong>
                Override the global <em>File Types</em> settings in each project.</li>
            <li><strong>Flexible pattern matching:</strong>
                Use globs (including <code>**</code>) and regular expressions.
                Match filenames or full directory paths in priority order.</li>
            <li><strong>VS Code and .gitattributes support:</strong>
                Optionally load file type associations from <code>.vscode/settings.json</code>
                and GitHub's <code>linguist-language</code> Git attributes.</li>
            <li><strong>Commit and share settings:</strong>
                Project file types are saved in <code>.idea/advancedFileType.xml</code>
                and can be checked into source control.</li>
            <li><strong>Integrated pattern tester:</strong>
                Easily verify rules and imported associations.</li>
            <li><strong>Free and open source:</strong>
                <a href="https://github.com/medmunds/advanced-file-types/blob/main/README.md">Docs</a> –
                <a href="https://github.com/medmunds/advanced-file-types">Code</a> –
                <a href="https://github.com/medmunds/advanced-file-types/issues">Issues</a></li>
        </ul>

        <h2>Examples</h2>
        <p>With the <strong>Advanced File Types</strong> plugin, you could…</p>
        <ul>
            <li>Change <code>*.html</code> to Handlebars in one project and EJS in another.</li>
            <li>Treat <code>docs/**/*.txt</code> as Markdown but other <code>*.txt</code> files as plain text.</li>
            <li>Enable JSON5 syntax for all of <code>config/*.json</code>.</li>
            <li>Stop reassigning <code>*.tpl</code> or <code>*.conf</code> every time you switch projects.</li>
        </ul>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.AdvancedFileTypesBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <errorHandler implementation="com.intellij.diagnostic.JetBrainsMarketplaceErrorReportSubmitter"/>
        <fileTypeOverrider implementation="com.medmunds.advancedfiletypes.AdvancedFileTypeOverrider"
                           order="last"/>
        <!--suppress PluginXmlCapitalization -->
        <notificationGroup id="com.medmunds.advancedfiletypes.settingsLoadErrors"
                           displayType="STICKY_BALLOON"
                           bundle="messages.AdvancedFileTypesBundle"
                           key="notification.group.advancedFileTypes"/>
        <projectConfigurable parentId="preferences.fileTypes"
                             id="com.medmunds.advancedfiletypes.settings"
                             key="settings.displayName"
                             instance="com.medmunds.advancedfiletypes.ui.AdvancedFileTypeConfigurable"/>
        <webHelpProvider implementation="com.medmunds.advancedfiletypes.help.AdvancedFileTypeWebHelpProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="com.medmunds.advancedfiletypes.vscode.VsCodeSettingsFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.medmunds.advancedfiletypes.gitattributes.GitAttributesFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.medmunds.advancedfiletypes.gitattributes.GitExecutableEventListener"
                  topic="git4idea.config.GitExecutableListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="com.medmunds.advancedfiletypes.gitattributes.GitRepositoryEventListener"
                  topic="git4idea.repo.GitRepositoryChangeListener"/>
    </projectListeners>

</idea-plugin>
