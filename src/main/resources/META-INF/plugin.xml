<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <!-- Unique identifier of the plugin. It should be FQN. It cannot be changed between the plugin versions. -->
    <id>com.medmunds.advancedfiletypes</id>

    <!-- Public plugin name should be written in Title Case.
     Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-name -->
    <name>Advanced File Types</name>

    <!-- A displayed Vendor name or Organization ID displayed on the Plugins Page. -->
    <vendor url="https://www.github.com/medmunds/advanced-file-types">Mike Edmunds</vendor>

    <!-- Description of the plugin displayed on the Plugin Page and IDE Plugin Manager.
         Guidelines: https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html#plugin-description -->
    <description><![CDATA[
        Extends the IDE's global File Types with project-specific overrides, using glob or regex patterns.

        <ul>
            <li><strong>Custom pattern matching:</strong>
                Globs or regular expressions, match filenames or full paths.
                Change HTML to Jinja2 only in <code>templates/**/*.html</code>.</li>
            <li><strong>Per-project settings:</strong>
                Treat <code>*.sql</code> as MySQL in one project and PostgreSQL in another.</li>
            <li><strong>VS Code settings compatibility:</strong>
                Reads <code>files.associations</code> from <code>.vscode/settings.json</code>.</li>
            <li><strong>GitHub Linguist compatibility:</strong>
                Reads <code>linguist-language</code> information from <code>.gitattributes</code>.</li>
            <li><strong>Free and open source:</strong>
                <a href="https://github.com/medmunds/advanced-file-types">Code and docs</a> -
                <a href="https://github.com/medmunds/advanced-file-types/issues">Issues</a></li>
        </ul>
        ]]></description>

    <!-- Product and plugin compatibility requirements.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-compatibility.html -->
    <depends>com.intellij.modules.platform</depends>
    <depends>Git4Idea</depends>

    <resource-bundle>messages.AdvancedFileTypesBundle</resource-bundle>

    <!-- Extensions defined by the plugin.
         Read more: https://plugins.jetbrains.com/docs/intellij/plugin-extension-points.html -->
    <extensions defaultExtensionNs="com.intellij">
        <fileTypeOverrider implementation="com.medmunds.advancedfiletypes.AdvancedFileTypeOverrider"/>
        <projectConfigurable parentId="editor"
                             id="com.medmunds.advancedfiletypes.settings"
                             key="settings.displayName"
                             instance="com.medmunds.advancedfiletypes.ui.AdvancedFileTypeConfigurable"/>
        <webHelpProvider implementation="com.medmunds.advancedfiletypes.help.AdvancedFileTypeWebHelpProvider"/>
    </extensions>

    <applicationListeners>
        <listener class="com.medmunds.advancedfiletypes.vscode.VsCodeSettingsFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
        <listener class="com.medmunds.advancedfiletypes.gitattributes.GitAttributesFileListener"
                  topic="com.intellij.openapi.vfs.newvfs.BulkFileListener"/>
    </applicationListeners>

    <projectListeners>
        <listener class="com.medmunds.advancedfiletypes.gitattributes.GitRepositoryEventListener"
                  topic="com.intellij.dvcs.repo.VcsRepositoryMappingListener"/>
    </projectListeners>

</idea-plugin>
