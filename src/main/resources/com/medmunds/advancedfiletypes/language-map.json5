// Static mapping from IntelliJ FileType names to language identifiers and aliases
// used by VS Code (files.associations) and GitHub Linguist (.gitattributes linguist-language).
//
// Reference sources:
// - VS Code Known Language Identifiers: https://code.visualstudio.com/docs/languages/identifiers#_known-language-identifiers
// - GitHub Linguist languages.yml: https://github.com/github-linguist/linguist/blob/master/lib/linguist/languages.yml
//
// Schema: { "IntelliJ_FileType_Name": ["alias1", "alias2", ...] }
// - Keys: Exact, case-sensitive JetBrains FileType.getName() identifiers.
// - Aliases: Lowercase external identifiers (resolved case-insensitively against incoming language IDs).
// Keys and alias arrays must be sorted alphabetically.
{
  ".env file": [
    "dotenv"
  ],
  "ActionScript": [
    "actionscript"
  ],
